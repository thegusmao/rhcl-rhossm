# Secret de repositório Git para Argo CD — template
#
# Copie este arquivo para 03-secret-lab-rhcl-ossm.yaml (gitignored) e
# preencha com as credenciais reais do repositório privado:
#
#   cp bootstrap/03-secret-lab-rhcl-ossm.yaml.example bootstrap/03-secret-lab-rhcl-ossm.yaml
#   # editar credenciais
#   oc apply -f bootstrap/03-secret-lab-rhcl-ossm.yaml
---
apiVersion: v1
kind: Secret
metadata:
  name: repository-lab-rhcl-ossm
  namespace: openshift-gitops
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  type: git
  url: https://github.com/thegusmao/rhcl-rhossm.git
  username: <token-user-or-username>
  password: <personal-access-token>
